# API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bella_massa?schema=public"
POSTGRES_PORT=5432
PORT=3000
WEB_URL="http://localhost:5173"
PUBLIC_MENU_URL="http://localhost:5173"
RESTAURANT_SLUG=""
JWT_SECRET="change-this-to-a-long-random-secret"

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN="change-me"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_DISPLAY_PHONE=""
WHATSAPP_API_VERSION="v23.0"
# Em true, bloqueia mensagens proativas e deixa o bot pausado depois do QR.
WHATSAPP_TEST_MODE="true"
WWEBJS_AUTH_PATH=""
# Opcional. No Windows, o Chrome instalado em Program Files é detectado automaticamente.
WWEBJS_CHROME_PATH=""
# Mantenha false localmente. No Railway o backend detecta o ambiente isolado automaticamente.
WWEBJS_DISABLE_SANDBOX="false"
META_APP_ID=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""
# Opcional: segredo aleatorio de 32+ caracteres exclusivo para criptografar tokens.
TOKEN_ENCRYPTION_SECRET="change-this-to-an-independent-random-secret-with-32-characters"

# Frontend
VITE_API_URL="http://localhost:3000/api"
