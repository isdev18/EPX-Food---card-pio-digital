generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  ATTENDANT
  KITCHEN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ConversationState {
  IDLE
  CHOOSING_CATEGORY
  CHOOSING_PRODUCT
  CHOOSING_SIZE
  CHOOSING_FLAVOR
  CHOOSING_CRUST
  CHOOSING_EXTRAS
  CHOOSING_DRINK
  REVIEWING_CART
  CHOOSING_DELIVERY_TYPE
  CHOOSING_ADDRESS
  CHOOSING_PAYMENT
  CONFIRMING_ORDER
  ORDER_CONFIRMED
  HUMAN_SUPPORT
}

enum ConversationMode {
  BOT
  HUMAN
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum WhatsAppProviderType {
  QR_SESSION
  META_CLOUD
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  INITIALIZING
  QR_REQUIRED
  CONNECTING
  CONNECTED
  RECONNECTING
  AUTH_FAILURE
  DISCONNECTED_BY_USER
  ERROR
}

model Restaurant {
  id String @id @default(cuid())
  name String
  slug String @unique
  phone String?
  logoUrl String?
  bannerUrl String?
  primaryColor String @default("#E94F37")
  secondaryColor String @default("#17352D")
  address Json?
  openingHours Json?
  deliveryEstimateMin Int @default(30)
  deliveryEstimateMax Int @default(50)
  minimumOrder Decimal @default(0) @db.Decimal(12, 2)
  acceptScheduledOrders Boolean @default(false)
  halfPizzaPricing String @default("HIGHEST")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  customers Customer[]
  addresses Address[]
  categories Category[]
  products Product[]
  pizzaSizes PizzaSize[]
  flavors Flavor[]
  extras Extra[]
  crusts Crust[]
  carts Cart[]
  orders Order[]
  deliveryZones DeliveryZone[]
  coupons Coupon[]
  promotions Promotion[]
  conversations Conversation[]
  whatsappConnections WhatsAppConnection[]
  menuSessions MenuSession[]
  analyticsEvents AnalyticsEvent[]
}

model User {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  email String
  passwordHash String
  role UserRole @default(ATTENDANT)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([restaurantId, email])
  @@index([restaurantId])
}

model Customer {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String?
  phone String
  lastOrderAt DateTime?
  orderCount Int @default(0)
  totalSpent Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  addresses Address[]
  carts Cart[]
  orders Order[]
  conversations Conversation[]
  menuSessions MenuSession[]
  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

model Address {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label String @default("Principal")
  street String
  number String
  complement String?
  neighborhood String
  city String
  reference String?
  zipCode String?
  createdAt DateTime @default(now())
  @@index([restaurantId, customerId])
}

model Category {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  icon String?
  position Int @default(0)
  active Boolean @default(true)
  products Product[]
  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Product {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  name String
  description String?
  imageUrl String?
  basePrice Decimal @db.Decimal(12, 2)
  ingredients String[]
  active Boolean @default(true)
  archivedAt DateTime?
  isPizza Boolean @default(false)
  cartItems CartItem[]
  orderItems OrderItem[]
  promotionItems PromotionItem[]
  @@unique([restaurantId, name])
  @@index([restaurantId, categoryId])
}

model PizzaSize {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  slices Int
  maxFlavors Int @default(1)
  priceMultiplier Decimal @default(1) @db.Decimal(6, 2)
  active Boolean @default(true)
  @@unique([restaurantId, name])
}

model Flavor {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  description String?
  surcharge Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)
  @@unique([restaurantId, name])
}

model Crust {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  price Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)
  @@unique([restaurantId, name])
}

model Extra {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  price Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  @@unique([restaurantId, name])
}

model Cart {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuSessionId String? @unique
  menuSession MenuSession? @relation(fields: [menuSessionId], references: [id], onDelete: Cascade)
  active Boolean @default(true)
  couponCode String?
  cartAbandonedAt DateTime?
  checkedOutAt DateTime?
  items CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([restaurantId, customerId, active])
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int @default(1)
  sizeName String?
  flavors Json?
  extras Json?
  crust Json?
  notes String?
  unitPrice Decimal @db.Decimal(12, 2)
  extrasPrice Decimal @default(0) @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)
}

model DeliveryZone {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  neighborhood String
  fee Decimal @db.Decimal(12, 2)
  estimatedMinutes Int
  active Boolean @default(true)
  @@unique([restaurantId, neighborhood])
}

model Coupon {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code String
  type DiscountType
  value Decimal @db.Decimal(12, 2)
  minimumOrder Decimal @default(0) @db.Decimal(12, 2)
  expiresAt DateTime?
  maxUses Int?
  uses Int @default(0)
  active Boolean @default(true)
  @@unique([restaurantId, code])
}

model Promotion {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name String
  description String?
  promotionalPrice Decimal? @db.Decimal(12, 2)
  startsAt DateTime
  endsAt DateTime?
  active Boolean @default(true)
  items PromotionItem[]
  @@index([restaurantId, active])
}

model PromotionItem {
  id String @id @default(cuid())
  promotionId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int @default(1)
  @@unique([promotionId, productId])
}

model Order {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  number Int
  subtotal Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status OrderStatus @default(NEW)
  address Json?
  notes String?
  estimatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  idempotencyKey String?
  trackingTokenHash String? @unique
  menuSessionId String? @unique
  menuSession MenuSession? @relation(fields: [menuSessionId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items OrderItem[]
  statusHistory OrderStatusHistory[]
  payment Payment?
  @@unique([restaurantId, idempotencyKey])
  @@unique([restaurantId, number])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  name String
  quantity Int
  configuration Json?
  notes String?
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)
}

model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status OrderStatus
  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider String @default("MANUAL")
  providerId String?
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(12, 2)
  changeFor Decimal? @db.Decimal(12, 2)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  state ConversationState @default(IDLE)
  mode ConversationMode @default(BOT)
  context Json?
  updatedAt DateTime @updatedAt
  messages Message[]
  menuSessions MenuSession[]
  orders Order[]
  @@unique([restaurantId, customerId])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId String? @unique
  direction String
  type String
  body String?
  payload Json?
  createdAt DateTime @default(now())
}

model WhatsAppConnection {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider WhatsAppProviderType @default(META_CLOUD)
  status WhatsAppConnectionStatus @default(DISCONNECTED)
  phoneNumberId String? @unique
  businessAccountId String?
  businessPortfolioId String?
  phoneNumber String?
  displayName String?
  displayPhone String?
  verifiedName String?
  qualityRating String?
  accessTokenEncrypted String?
  tokenExpiresAt DateTime?
  active Boolean @default(true)
  connectedAt DateTime?
  disconnectedAt DateTime?
  lastActivityAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([restaurantId, provider])
  @@index([restaurantId, status])
}

model MenuSession {
  id String @id @default(cuid())
  tokenHash String @unique
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  cart Cart?
  order Order?
  @@index([restaurantId, expiresAt])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuSessionId String?
  name String
  payload Json?
  createdAt DateTime @default(now())
  @@index([restaurantId, name, createdAt])
}
